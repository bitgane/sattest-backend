# -----------------------------------------------------------------------------
# sattest-backend environment variables
#
# Copy to `.env` for local dev: `cp .env.example .env`
# In production (Railway), set these in the service's Variables tab.
# NEVER commit real values for anything marked SECRET.
# -----------------------------------------------------------------------------

# Runtime mode: "development" or "production".
# Controls CORS strictness, Nostr event freshness windows, the SSRF guard, and
# whether internal error detail is echoed to clients. Defaults here to
# `production` (fail-safe): a deploy that copies this file unedited stays
# locked down. Set to `development` ONLY for local work — it disables auth-event
# expiry, allows all CORS origins, relaxes the SSRF guard, and leaks error text.
NODE_ENV=production

# Port the Express server binds to. Railway injects this automatically — do not
# hardcode in production.
PORT=3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL, required)
# -----------------------------------------------------------------------------
# On Railway, reference the Postgres plugin's DATABASE_URL via a variable
# reference rather than pasting the value.
# SECRET.
DATABASE_URL=postgresql://user:password@localhost:5432/sattest

# -----------------------------------------------------------------------------
# LNbits integration (required)
# -----------------------------------------------------------------------------
# Base URL of your LNbits instance (no trailing slash).
LNBITS_URL=https://your-lnbits-host.example.com

# LNbits invoice/read key for the funding wallet — used to create invoices and
# check paid status. SECRET.
LNBITS_INVOICE_KEY=

# LNbits admin key — required for creating payouts and provisioning per-user
# wallets. SECRET.
LNBITS_API_KEY=

# -----------------------------------------------------------------------------
# Wallet key encryption (required)
# -----------------------------------------------------------------------------
# AES-256-GCM key used to encrypt per-user LNbits wallet keys at rest.
# Must be a base64-encoded 32-byte value. Generate with:
#   openssl rand -base64 32
# Rotating this value will make existing encrypted wallet keys unreadable.
# SECRET.
WALLET_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (required in production).
# VSCode extension requests from the Node extension host have no Origin header
# and are allowed through by the middleware; this list governs browser clients.
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Nostr
# -----------------------------------------------------------------------------
# Comma-separated list of Nostr relay WebSocket URLs.
NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol,wss://relay.nsec.app

# Audience binding for Nostr auth events (defense-in-depth). Set to this
# service's own public base URL, e.g.
#   https://your-backend.example.com
# When set, an auth event is accepted only if it carries a ["relay", <url>] tag
# whose origin matches — so a credential harvested by another server can't be
# replayed here. Must equal the `sattest.backendUrl` the extension uses. Leave
# blank to disable the check (e.g. local dev).
AUTH_AUDIENCE=

# -----------------------------------------------------------------------------
# Payout security (honeypot mitigation)
#
# LNBITS_INVOICE_KEY should point at the "Treasury" wallet (inbound only).
# LNBITS_API_KEY    should point at the "Payout"   wallet (near-empty, hot).
# Provision both wallets manually in LNbits and top up Payout from Treasury
# via the dashboard as needed — the backend never performs internal transfers.
# -----------------------------------------------------------------------------

# Kill switch. Set to "false" to immediately halt outbound payouts without
# taking the service down. Inbound invoices continue to work. Default: true.
PAYOUTS_ENABLED=true

# Custodial bounty path (LNbits invoice/QR; backend holds funds). Default:
# "false" — NWC (non-custodial) is the only allowed funding mode and POST
# /bounties rejects fundingMode:'custodial' with a 400. Flip to "true" (and
# configure the LNBITS_* vars above) to re-enable the custodial flow.
ALLOW_CUSTODIAL_BOUNTIES=false

# Circuit-breaker caps on cumulative approved payouts. A /approve request that
# would push either window over the cap is rejected with 429 and an alert.
PAYOUT_CAP_HOURLY_SATS=1000000
PAYOUT_CAP_DAILY_SATS=10000000

# Single-payout amount that triggers an anomaly alert (but does not block).
PAYOUT_ALERT_SATS=500000

# Hot-wallet sanity check: payout is halted if the Payout wallet's balance
# exceeds this multiple of the payout being made. Too-low = false positives
# with normal buffer liquidity; too-high = the guard never fires. Default: 10.
PAYOUT_BALANCE_MULTIPLIER=10

# Optional webhook for anomaly alerts (Slack Incoming Webhook, ntfy, etc.).
# JSON body: { service, event, at, bountyId, claimId?, amountSats, reason, approvedBy? }
ALERT_WEBHOOK_URL=
